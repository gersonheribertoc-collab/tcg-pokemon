<Window x:Class="AlmacenPokemonWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Almacén TCG Pokémon" Height="500" Width="880"
        Background="#F0F2F5" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con Saludo -->
        <Border Grid.Row="0" Background="#E3350D" CornerRadius="10" Padding="15" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Hola buenos días profesor Ricardo y alumnos" 
                           FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Tienda y Almacén Oficial TCG Pokémon" 
                           FontSize="14" Foreground="#FFCB05" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Grid para los 4 Productos -->
        <UniformGrid Grid.Row="1" Columns="4" Rows="1">
            <!-- Producto 1 -->
            <Border Background="White" BorderBrush="#3B4CCA" BorderThickness="2" CornerRadius="10" Margin="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtNombre1" Grid.Row="0" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Foreground="#2A75BB"/>
                    <TextBlock x:Name="txtEdicion1" Grid.Row="1" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtPrecio1" Grid.Row="2" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="3">
                        <Button Content="+ $50 (Herencia)" Click="BtnAumentar1_Click" Background="#FFCB05" Foreground="#3C5AA6" FontWeight="Bold" Padding="6" Margin="0,2"/>
                        <Button Content="- $20 (Herencia)" Click="BtnDisminuir1_Click" Background="#FF5959" Foreground="White" FontWeight="Bold" Padding="6" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Producto 2 -->
            <Border Background="White" BorderBrush="#3B4CCA" BorderThickness="2" CornerRadius="10" Margin="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtNombre2" Grid.Row="0" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Foreground="#2A75BB"/>
                    <TextBlock x:Name="txtEdicion2" Grid.Row="1" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtPrecio2" Grid.Row="2" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="3">
                        <Button Content="+ $50 (Herencia)" Click="BtnAumentar2_Click" Background="#FFCB05" Foreground="#3C5AA6" FontWeight="Bold" Padding="6" Margin="0,2"/>
                        <Button Content="- $20 (Herencia)" Click="BtnDisminuir2_Click" Background="#FF5959" Foreground="White" FontWeight="Bold" Padding="6" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Producto 3 -->
            <Border Background="White" BorderBrush="#3B4CCA" BorderThickness="2" CornerRadius="10" Margin="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtNombre3" Grid.Row="0" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Foreground="#2A75BB"/>
                    <TextBlock x:Name="txtEdicion3" Grid.Row="1" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtPrecio3" Grid.Row="2" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="3">
                        <Button Content="+ $50 (Herencia)" Click="BtnAumentar3_Click" Background="#FFCB05" Foreground="#3C5AA6" FontWeight="Bold" Padding="6" Margin="0,2"/>
                        <Button Content="- $20 (Herencia)" Click="BtnDisminuir3_Click" Background="#FF5959" Foreground="White" FontWeight="Bold" Padding="6" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Producto 4 -->
            <Border Background="White" BorderBrush="#3B4CCA" BorderThickness="2" CornerRadius="10" Margin="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtNombre4" Grid.Row="0" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Foreground="#2A75BB"/>
                    <TextBlock x:Name="txtEdicion4" Grid.Row="1" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                    <TextBlock x:Name="txtPrecio4" Grid.Row="2" FontSize="20" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Row="3">
                        <Button Content="+ $50 (Herencia)" Click="BtnAumentar4_Click" Background="#FFCB05" Foreground="#3C5AA6" FontWeight="Bold" Padding="6" Margin="0,2"/>
                        <Button Content="- $20 (Herencia)" Click="BtnDisminuir4_Click" Background="#FF5959" Foreground="White" FontWeight="Bold" Padding="6" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>
    </Grid>
</Window>